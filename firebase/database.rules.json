{
  "rules": {
    ".read": false,
    ".write": false,
    "categories": { ".read": true },
    "concerts": { ".read": true },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren([\"user_id\",\"first_name\",\"last_name\",\"email\"]) && newData.child(\"user_id\").val() === $uid"
      }
    },
    "seats": {
      ".read": true,
      ".indexOn": ["concert_id"],
      "$seatId": {
        ".write": "auth != null && data.exists() && data.child(\"status\").val() === \"Available\" && newData.child(\"status\").val() === \"Booked\" && newData.child(\"booked_by\").val() === auth.uid && newData.child(\"concert_id\").val() === data.child(\"concert_id\").val() && newData.child(\"price\").val() === data.child(\"price\").val()"
      }
    },
    "bookings": {
      ".indexOn": ["user_id"],
      ".read": "auth != null && query.orderByChild === \"user_id\" && query.equalTo === auth.uid",
      "$bookingId": {
        ".write": "auth != null && !data.exists() && newData.child(\"user_id\").val() === auth.uid",
        ".validate": "newData.hasChildren([\"booking_id\",\"user_id\",\"concert_id\",\"seat_ids\",\"total_price\",\"booking_date\",\"payment_status\"])"
      }
    },
    "favorites": {
      ".indexOn": ["user_id"],
      ".read": "auth != null && query.orderByChild === \"user_id\" && query.equalTo === auth.uid",
      "$favoriteId": {
        ".write": "auth != null && (newData.exists() ? newData.child(\"user_id\").val() === auth.uid : data.child(\"user_id\").val() === auth.uid)",
        ".validate": "newData.hasChildren([\"favorite_id\",\"user_id\",\"concert_id\"])"
      }
    }
  }
}
